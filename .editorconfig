# Moov Mail — editor defaults.
# https://editorconfig.org
#
# Contributors work on Windows, macOS and Linux. Without this file the
# repository accumulates mixed indentation and CRLF noise in diffs; with it the
# editor does the right thing before git has to.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go is gofmt's territory: tabs, and gofmt decides the rest.
[*.go]
indent_style = tab
indent_size = 4

[go.mod]
indent_style = tab

# Make requires literal tabs in recipes. Getting this wrong produces the
# infamous "missing separator" error.
[Makefile]
indent_style = tab
indent_size = 4

[*.{md,markdown}]
# Two trailing spaces are a hard line break in Markdown, so trimming them
# silently changes rendered output.
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.sql]
indent_size = 4

# ---------------------------------------------------------------------------
# The pathological MIME corpus is made of BYTE-EXACT test vectors. Several
# cases exist precisely to test CR-only, LF-only or missing final newlines.
# An editor that "helpfully" normalizes them destroys what they test — the same
# hazard .gitattributes guards against on git's side.
# ---------------------------------------------------------------------------
[*.eml]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset

[*.mbox]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
