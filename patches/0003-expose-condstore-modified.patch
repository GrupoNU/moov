+++ b/imapclient/fetch.go
@@ -154,10 +154,35 @@ type FetchCommand struct {
 	recvSeqSet imap.SeqSet
 	recvUIDSet imap.UIDSet
 
+	// modified carries the RFC 7162 [MODIFIED <set>] response code of a
+	// conditional STORE. It is written by the decoder goroutine before the
+	// command completes and read after Close/Wait, so no lock is needed.
+	modified imap.NumSet
+
 	msgs chan *FetchMessageData
 	prev *FetchMessageData
 }
 
+// Modified returns the message set the server refused to update, as reported
+// by the RFC 7162 [MODIFIED <set>] response code of a conditional STORE
+// (Client.Store with StoreOptions.UnchangedSince).
+//
+// It returns nil when the command was not a conditional STORE, or when every
+// message was updated. A non-nil, non-empty result means the server rejected
+// those messages because they changed since the given modification sequence:
+// the STORE completed with a tagged OK and no error, yet the flags were NOT
+// applied. Callers doing optimistic concurrency MUST check this — a nil error
+// from a conditional STORE does not by itself mean the write took effect.
+//
+// The set is a imap.UIDSet for UID STORE and a imap.SeqSet for STORE, matching
+// the numbering of the command that produced it.
+//
+// Modified is only valid after the command has completed (after Close, Wait or
+// Collect).
+func (cmd *FetchCommand) Modified() imap.NumSet {
+	return cmd.modified
+}
