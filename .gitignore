# Secrets & local config
.env
.env.*
*.local
credentials/

# Go
bin/
dist/
*.exe
coverage.out

# Node / frontend
node_modules/
.pnpm-store/
*.tsbuildinfo

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Data from spikes / local runs
data/
*.eml
*.mbox

# Playwright MCP browser-verification artifacts (console logs, snapshots,
# screenshots). These are evidence for a single manual verification run, not
# fixtures: they name a host and a session and are worthless to anyone else.
.playwright-mcp/

# ...except the pathological MIME corpus, which is a committed test fixture:
# these .eml files ARE the parser's regression suite (S4). Without these
# negations the blanket *.eml rule above silently hides the entire corpus.
!testdata/mime-corpus/**/*.eml
!testdata/mime-corpus/**/*.mbox
