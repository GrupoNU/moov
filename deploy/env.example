# Moov Mail — deployment configuration template.
#
# Copy to .env NEXT TO docker-compose.yml and fill in the values:
#
#   cp env.example .env && $EDITOR .env
#
# .env is git-ignored and MUST NEVER be committed: it carries the master key
# that decrypts every stored app password. Treat it like a private key —
# `chmod 600 .env`, and back it up somewhere that is not this repository.
#
# Every variable moovd reads is listed here, including the ones with defaults,
# so this file doubles as the configuration reference for the deployment.

# =============================================================================
# REQUIRED — the stack refuses to start without these
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
# The store's password. Generate a fresh one, never reuse another service's:
#   openssl rand -base64 32
MOOV_PG_PASSWORD=

# --- Credential encryption --------------------------------------------------
# The AES-256-GCM master key that seals every account's app password (ADR §4).
# Generate with:
#   docker run --rm --entrypoint /usr/local/bin/moovctl moov/moovd:pilot key generate
# or, from a checkout:
#   go run ./cmd/moovctl key generate
#
# LOSING THIS KEY MEANS EVERY STORED CREDENTIAL IS UNRECOVERABLE and every
# account must be re-provisioned. Back it up before the first account is added.
#
# Format: "<id>:<base64>" — the id prefix is what makes rotation possible
# (moovctl key rotate).
MOOV_MASTER_KEY=

# --- Dovecot's certificate name ---------------------------------------------
# Spike S1 H2: Moov dials the container alias `dovecot`, but Dovecot's
# certificate carries the PUBLIC mail hostname. Verifying against the alias
# would fail, so this names what the certificate actually says — which keeps the
# connection VERIFIED instead of falling back to "trust anything".
#
# This is the hostname on the Mailcow certificate, e.g. mail.example.com.
MOOV_IMAP_SERVER_NAME=

# --- The URL the BROWSER reaches ---------------------------------------------
# The absolute base URL that goes into the JMAP session object's apiUrl,
# downloadUrl and friends. It MUST be the address the browser talks to — the
# Caddy front — and NOT moovd's own listener, or every client follows apiUrl
# straight into a dead end.
#
# For the VPN-only pilot this is the Tailscale address Caddy binds:
#   http://100.123.119.124:8090
MOOV_JMAP_EXTERNAL_URL=

# =============================================================================
# OPTIONAL — sensible defaults, listed so they can be found
# =============================================================================

# --- PostgreSQL identity (defaults: moov / moov) ----------------------------
#MOOV_PG_USER=moov
#MOOV_PG_DATABASE=moov

# --- Mailcow integration ----------------------------------------------------
# The external Docker network to join. Only change this if Mailcow was installed
# under a different compose project name.
#MOOV_MAILCOW_NETWORK=mailcowdockerized_mailcow-network

# --- The front's network ----------------------------------------------------
# The EXTERNAL network the Caddy front sits on, so `reverse_proxy moovd:8620`
# in Caddyfile.pilot resolves the alias. Compose attaches moovd to it on every
# recreation — it must never be a manual `docker network connect` again, because
# that attachment is lost the moment the container is recreated and the front
# starts answering 502.
#
# Both this network and Mailcow's must already exist: compose joins them, it
# never creates them.
#MOOV_FRONT_NETWORK=moov-spike

# Where the JMAP server validates logins (J-A1). Inside the Mailcow network the
# container alias and STARTTLS on 143 are the right answer.
#MOOV_JMAP_IMAP_HOST=dovecot
#MOOV_JMAP_IMAP_PORT=143

# --- Sync engine ------------------------------------------------------------
# Both default to on. Turn the watcher OFF for a bulk migration run, where a
# watcher per account competes with the backfill for the connection budget.
#MOOV_SYNC_ENABLED=1
#MOOV_SYNC_WATCHER=1

# --- CORS -------------------------------------------------------------------
# Empty by default: the pilot serves Bulwark and moovd from ONE origin through
# Caddy, so no Access-Control headers are needed at all. Set a comma-separated
# origin list only if a client is served from somewhere else (spike S1 H7).
#MOOV_JMAP_CORS_ORIGINS=

# --- Logging ----------------------------------------------------------------
#MOOV_LOG_LEVEL=info      # debug | info | warn | error
#MOOV_LOG_FORMAT=json     # json (production) | text (console)

# --- Build identity ---------------------------------------------------------
# Stamped into the binary and exported as moov_build_info. The deploy script
# fills these from git; they are cosmetic.
#MOOV_VERSION=pilot
#MOOV_COMMIT=
#MOOV_BUILD_DATE=
#MOOV_IMAGE=moov/moovd:pilot
