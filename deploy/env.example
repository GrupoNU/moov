# Moov Mail — deployment configuration template.
#
# Copy to .env NEXT TO docker-compose.yml and fill in the values:
#
#   cp env.example .env && $EDITOR .env
#
# .env is git-ignored and MUST NEVER be committed: it carries the master key
# that decrypts every stored app password. Treat it like a private key —
# `chmod 600 .env`, and back it up somewhere that is not this repository.
#
# Every variable moovd reads is listed here, including the ones with defaults,
# so this file doubles as the configuration reference for the deployment.

# =============================================================================
# REQUIRED — the stack refuses to start without these
# =============================================================================

# --- PostgreSQL -------------------------------------------------------------
# The store's password. Generate a fresh one, never reuse another service's:
#   openssl rand -base64 32
MOOV_PG_PASSWORD=

# --- Credential encryption --------------------------------------------------
# The AES-256-GCM master key that seals every account's app password (ADR §4).
# Generate with:
#   docker run --rm --entrypoint /usr/local/bin/moovctl moov/moovd:pilot key generate
# or, from a checkout:
#   go run ./cmd/moovctl key generate
#
# LOSING THIS KEY MEANS EVERY STORED CREDENTIAL IS UNRECOVERABLE and every
# account must be re-provisioned. Back it up before the first account is added.
#
# Format: "<id>:<base64>" — the id prefix is what makes rotation possible
# (moovctl key rotate).
MOOV_MASTER_KEY=

# --- Dovecot's certificate name ---------------------------------------------
# Spike S1 H2: Moov dials the container alias `dovecot`, but Dovecot's
# certificate carries the PUBLIC mail hostname. Verifying against the alias
# would fail, so this names what the certificate actually says — which keeps the
# connection VERIFIED instead of falling back to "trust anything".
#
# This is the hostname on the Mailcow certificate, e.g. mail.example.com.
MOOV_IMAP_SERVER_NAME=

# --- The URL the BROWSER reaches ---------------------------------------------
# The absolute base URL that goes into the JMAP session object's apiUrl,
# downloadUrl and friends. It MUST be the address the browser talks to — the
# Caddy front — and NOT moovd's own listener, or every client follows apiUrl
# straight into a dead end.
#
# For the VPN-only pilot this is the Tailscale address Caddy binds:
#   http://100.123.119.124:8090
MOOV_JMAP_EXTERNAL_URL=

# =============================================================================
# OPTIONAL — sensible defaults, listed so they can be found
# =============================================================================

# --- PostgreSQL identity (defaults: moov / moov) ----------------------------
#MOOV_PG_USER=moov
#MOOV_PG_DATABASE=moov

# --- Mailcow integration ----------------------------------------------------
# The external Docker network to join. Only change this if Mailcow was installed
# under a different compose project name.
#MOOV_MAILCOW_NETWORK=mailcowdockerized_mailcow-network

# --- The front's network ----------------------------------------------------
# The EXTERNAL network the Caddy front sits on, so `reverse_proxy moovd:8620`
# in Caddyfile.pilot resolves the alias. Compose attaches moovd to it on every
# recreation — it must never be a manual `docker network connect` again, because
# that attachment is lost the moment the container is recreated and the front
# starts answering 502.
#
# Both this network and Mailcow's must already exist: compose joins them, it
# never creates them.
#MOOV_FRONT_NETWORK=moov-spike

# Where the JMAP server validates logins (J-A1). Inside the Mailcow network the
# container alias and STARTTLS on 143 are the right answer.
#MOOV_JMAP_IMAP_HOST=dovecot
#MOOV_JMAP_IMAP_PORT=143

# --- Sync engine ------------------------------------------------------------
# Both default to on. Turn the watcher OFF for a bulk migration run, where a
# watcher per account competes with the backfill for the connection budget.
#MOOV_SYNC_ENABLED=1
#MOOV_SYNC_WATCHER=1

# --- CORS -------------------------------------------------------------------
# Empty by default: the pilot serves Bulwark and moovd from ONE origin through
# Caddy, so no Access-Control headers are needed at all. Set a comma-separated
# origin list only if a client is served from somewhere else (spike S1 H7).
#MOOV_JMAP_CORS_ORIGINS=

# --- Branding (W-A1) --------------------------------------------------------
# HOST directory of the per-host branding files, bind-mounted read-only into
# the container at /etc/moov/branding (docker-compose.yml sets
# MOOV_BRANDING_DIR to that container path; you do not set it here). Each host
# gets <dir>/<hostname>/branding.json plus its validated images, written by
# `moovctl branding set -host <h> ...` on the host, and served as the brand
# document (GET /branding), the PWA manifest and the generated icons.
#
# AN EMPTY DIRECTORY IS A COMPLETE CONFIGURATION, not a missing one: every host
# is answered with Moov's own brand, which is what the pilot serves today. If
# the directory does not exist Docker creates it empty on first start. An
# unreadable one logs a warning and falls back to the same defaults — it never
# fails startup, because refusing to boot a mail server over a logo directory
# would be the wrong trade.
#
# Changes are picked up within a minute; no restart. `moovctl` defaults to the
# same path (MOOV_BRANDING_DIR on the host, or /etc/moov/branding).
#MOOV_BRANDING_HOST_DIR=/etc/moov/branding

# --- The per-domain accounts API (M1) ---------------------------------------
# A read-write Mailcow API key, and THE switch that turns the accounts API on:
# with neither variable set, every /admin/accounts route answers the same
# generic 404 an unknown route answers, so a prober cannot learn the feature
# exists here and is merely off. Set exactly ONE of the two.
#
# It is a DIFFERENT variable from MOOV_MAILCOW_API_KEY above on purpose: that
# one is moovctl's and lives on an operator's machine for the length of one
# command; this one lives in a long-running, network-facing process.
#
# MAILCOW DOES NOT SCOPE API KEYS BY DOMAIN. This key can touch every mailbox
# on the server, and the only boundary between one consumer and another's mail
# is Moov's own per-domain check. Restrict the key by source IP on Mailcow's
# side (Mailcow honours that strictly — F0 P4), and treat the value like
# MOOV_MASTER_KEY. See deploy/README.md, "The Mailcow write key and its trust
# boundary".
#MOOV_MAILCOW_WRITE_KEY=
#MOOV_MAILCOW_WRITE_KEY_FILE=/run/secrets/mailcow-write-key

# The installation's ceiling for a mailbox quota, in MB. A create without
# quotaMB gets 2048; the floor is 64.
#MOOV_ACCOUNTS_MAX_QUOTA_MB=10240

# --- Delegated sign-in (M2) -------------------------------------------------
# A JSON ARRAY of issuer entries, and the switch for delegated sign-in: unset
# means every /auth/delegated/* route answers the generic 404 and
# `Authorization: Bearer` is refused, on every host.
#
# A MALFORMED value is FATAL at startup — an operator who wrote this JSON meant
# to enable the feature, and starting without it would hand the external system
# a 404 to debug from outside, where it can learn nothing. Each entry needs all
# three fields: `host` is a BARE hostname (no scheme, no port; it is compared
# against the token's `aud`), `issuer` is the exact `iss` string, and `jwksUrl`
# must be an absolute HTTPS URL.
#MOOV_DELEGATED_ISSUERS=[{"host":"mail.example.test","issuer":"https://portal.example.test","jwksUrl":"https://portal.example.test/.well-known/jwks.json"}]

# The ABSOLUTE session lifetime, as a Go duration. A ceiling, not the session
# length: a delegated session also carries a sliding 12 h expiry, so an idle one
# dies long before this. Must be positive.
#MOOV_DELEGATED_SESSION_MAX=168h

# --- Logging ----------------------------------------------------------------
#MOOV_LOG_LEVEL=info      # debug | info | warn | error
#MOOV_LOG_FORMAT=json     # json (production) | text (console)

# --- Build identity ---------------------------------------------------------
# Stamped into the binary and exported as moov_build_info. The deploy script
# fills these from git; they are cosmetic.
#MOOV_VERSION=pilot
#MOOV_COMMIT=
#MOOV_BUILD_DATE=
#MOOV_IMAGE=moov/moovd:pilot
